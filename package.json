{
  "name": "refcheckid-mob",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "start:codespace": "EXPO_UNSTABLE_HEADLESS=1 EXPO_PUBLIC_API_BASE_URL=\"${EXPO_PUBLIC_API_BASE_URL:-$(node -p 'require(\"./eas.json\").build.preview.env.EXPO_PUBLIC_API_BASE_URL')}\" expo start --dev-client --tunnel"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tanstack/react-query": "^5.83.0",
    "expo": "~57.0.34",
    "expo-constants": "~57.0.25",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.22",
    "expo-image-manipulator": "~57.0.23",
    "expo-image-picker": "~57.0.22",
    "expo-linking": "~57.0.14",
    "expo-router": "~57.0.32",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.17",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
