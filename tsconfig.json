{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "app",
    "src",
    "__tests__",
    "jest.setup.ts"
  ],
  "extends": "expo/tsconfig.base"
}
